@{
    ViewBag.Title = "AdventureWorks Product Advisor";
}

@* No Bootstrap/jQuery in this project - everything below is plain inline
   styles rather than framework classes, and chat-widget.js uses only
   built-in browser APIs (fetch, DOM methods). *@
<div style="max-width: 700px; margin: 0 auto;">
    <h2>AdventureWorks Product Advisor</h2>

    @* Which pipeline answers the next question - read by chat-widget.js's
       getSelectedMode() and sent as "Mode" in the POST body. *@
    <div style="margin-bottom: 12px;">
        <label>
            <input type="radio" name="mode" value="CSharp" checked="checked" /> C# Pipeline
        </label>
        <label style="margin-left: 20px;">
            <input type="radio" name="mode" value="StoredProc" /> Stored Procedure
        </label>
    </div>

    @* min/max here are just a UI convenience (the native number-spinner
       arrows clamp to this range) - AskController still validates TopN is
       between 1 and 10 server-side regardless, since a direct API call
       could send anything. *@
    <div style="margin-bottom: 12px;">
        <label for="topN">Reviews to retrieve (1-10):</label>
        <input type="number" id="topN" min="1" max="10" step="1" value="5" style="width: 60px;" />
    </div>

    <div style="margin-bottom: 12px;">
        <input type="text" id="question" style="width: 100%; padding: 6px;" placeholder="Ask a question about our products..." />
    </div>

    @* Click handler for this button is wired up in chat-widget.js, not here. *@
    <button type="button" id="askButton">Ask</button>

    @* chat-widget.js appends one bubble per answer into this div. *@
    <div id="chatHistory" style="margin-top: 20px;"></div>
</div>

@* @RenderSection("scripts") in _Layout.cshtml is what pulls this in, placed
   after the page body so the DOM elements above already exist when the
   script runs. *@
@section scripts {
    <script src="~/Scripts/chat-widget.js"></script>
}
